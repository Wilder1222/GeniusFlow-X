                        {
                            "role": "ai",
                            "content": "Okay! I'll generate English grammar flashcards for you. Summarizing core rules..."
                        },
                        {
                            "role": "ai",
                            "content": "Generated 3 high-quality flashcards!",
                            "cards": [
                                {
                                    "front": "What are the tenses in English?",
                                    "back": "English has 12 basic tenses:\n\nPresent: Simple, Continuous, Perfect, Perfect Continuous\nPast: Simple, Continuous, Perfect, Perfect Continuous\nFuture: Simple, Continuous, Perfect, Perfect Continuous"
                                },
                                {
                                    "front": "When to use Present Perfect Tense?",
                                    "back": "Present Perfect (have/has + past participle) is used for:\n1. Past actions affecting the present\n2. Actions continuing from past to present\n3. With words like ever, never, just, already\n\ne.g., I have finished my homework."
                                },
                                {
                                    "front": "Difference between 'a/an' and 'the'?",
                                    "back": "'a/an' (Indefinite Article):\n- First mention\n- General reference\n- 'a' before consonants, 'an' before vowels\n\n'the' (Definite Article):\n- Specific/known things\n- Unique things\n- Previously mentioned things"
                                }
                            ]
                        }
                    ]
                }
