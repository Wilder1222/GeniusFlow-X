                            "cards": [
                                {
                                    "front": "What are React Hooks?",
                                    "back": "React Hooks are a core feature introduced in React 16.8 that allow you to use state and other React features (like lifecycle, context) in function components without writing a class."
                                },
                                {
                                    "front": "What are the common React Hooks?",
                                    "back": "1. useState: Manage local state\n2. useEffect: Handle side effects\n3. useContext: Subscribe to Context\n4. useRef: Access DOM references"
                                },
                                {
                                    "front": "What are the advantages of React Hooks?",
                                    "back": "1. Cleaner code: Avoid class 'this' binding\n2. Flexible logic reuse: Reuse state logic via custom Hooks\n3. Separation of concerns: Split into independent functions"
                                }
                            ]
                        }
                    ]
