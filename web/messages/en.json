                "biology": {
                    "label": "Cell Structure",
                    "messages": [
                        {
                            "role": "user",
                            "content": "Generate flashcards about biological cell structure"
                        },
                        {
                            "role": "ai",
                            "content": "Okay! I'll generate cell structure flashcards for you. Organizing key points..."
                        },
                        {
                            "role": "ai",
                            "content": "Generated 3 high-quality flashcards!",
                            "cards": [
                                {
                                    "front": "What are the basic parts of a cell?",
                                    "back": "Basic cell structure includes:\n1. Cell Membrane: Controls substance entry/exit\n2. Cytoplasm: Metabolic activities host\n3. Nucleus: Stores genetic info\n4. Mitochondria: Power plant\n5. Ribosomes: Protein synthesis site"
                                },
                                {
                                    "front": "What are the main differences between animal and plant cells?",
                                    "back": "Plant cells only:\n1. Cell Wall: Support and protection\n2. Chloroplasts: Photosynthesis\n3. Large Vacuole: Stores water and nutrients\n\nAnimal cells only:\n1. Centrosomes: Cell division"
                                },
                                {
                                    "front": "Why are mitochondria called the 'power plant' of the cell?",
                                    "back": "Mitochondria are the main site of aerobic respiration, releasing energy by oxidizing organic matter and converting ADP to ATP for cellular activities."
                                }
                            ]
                        }
                    ]
                },
                "geography": {
                    "label": "World Geography",
                    "messages": [
                        {
                            "role": "user",
                            "content": "Generate flashcards about world geography"
                        },
                        {
                            "role": "ai",
                            "content": "Sure! I'll generate world geography flashcards for you. Compiling important facts..."
                        },
                        {
                            "role": "ai",
                            "content": "Generated 3 high-quality flashcards!",
                            "cards": [
                                {
                                    "front": "What are the 7 continents ordered by size?",
                                    "back": "1. Asia (44.58M km²)\n2. Africa (30.20M km²)\n3. North America (24.22M km²)\n4. South America (17.84M km²)\n5. Antarctica (14.00M km²)\n6. Europe (10.16M km²)\n7. Oceania (8.97M km²)"
                                },
                                {
                                    "front": "What is the longest river in the world?",
                                    "back": "The Nile, about 6670 km long, flowing through East and North Africa.\n\nSecond is the Amazon (approx 6400km), third is the Yangtze (approx 6300km)."
                                },
                                {
                                    "front": "What is Plate Tectonics theory?",
                                    "back": "Plate Tectonics states the Earth's lithosphere is divided into huge plates floating on the asthenosphere. At boundaries:\n1. Collision: Forms mountains\n2. Separation: Forms rifts\n3. Sliding: Causes earthquakes"
                                }
                            ]
                        }
                    ]
                },
